SECRET_KEY=change-this-before-deployment
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Used only if the main model is temporarily overloaded (HTTP 503).
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Optional paid alternative: set AI_PROVIDER=openai and configure these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
